# Tu token personal: https://sketchfab.com/settings/password  (sección "API Token")
SKETCHFAB_TOKEN=pega_aqui_tu_token

# Catálogo de piezas reales (opcional): https://developer.ebay.com → Application Keys (Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Mercado: EBAY_ES, EBAY_DE, EBAY_GB, EBAY_US…
EBAY_MARKETPLACE=EBAY_ES

# 3D con IA a partir de fotos (opcional): https://platform.tripo3d.ai → API Keys
TRIPO_API_KEY=
